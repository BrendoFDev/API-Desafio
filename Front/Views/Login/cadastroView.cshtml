@{
    ViewData["Title"] = "Cadastro";
    Layout = null;
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Front.styles.css" asp-append-version="true" />
</head>
<body class="d-flex justify-content-center" style="background-color: lightsteelblue">

    <div class="d-flex flex-column w-100" style="margin-top: 100px">

        <div class="text-center mb-3">
            <img src="/JPLM.png" style="height: 100px; width: auto; object-fit: contain;" />
        </div>

        <div class="d-flex card shadow p-4 align-self-center" style="background-color: rgba(255, 255, 255); border-radius: 15px; height: 400px; width: 700px;">
            <div class="text-center" style="width: 100%;">
                <h1 class="mb-4">Cadastro</h1>
                <form>
                    <div class="d-flex flex-column align-items-center gap-4 mb-3">
                        <input type="text" class="form-control" placeholder="Digite o nome de usuário" />
                        <input type="email" class="form-control" placeholder="Digite o email a ser cadastrado" />
                        <input type="password" class="form-control" placeholder="Digite a sua senha" />
                    </div>
                    <button class="btn btn-success mt-4">Cadastrar</button>
                </form>
            </div>
        </div>

    </div>




    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
