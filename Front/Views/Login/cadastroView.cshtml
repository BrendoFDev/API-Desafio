@{
    ViewData["Title"] = "Cadastro";
    Layout = null;
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Front.styles.css" asp-append-version="true" />
</head>
<body class="d-flex justify-content-center" style="background-color: #eef3f8">

    <div class="d-flex card shadow flex-column align-self-center align-items-center rounded-start-4 rounded-end-0" style="background-color: #24374c; height: 540px; width: 300px;">
        <img class="p-3 mt-3 img-fluid" style="border-radius: 15px; max-width: 250px; max-height: 110px;" src="~/JPLM.png" />
        <hr class="w-75 mx-auto" style="border-bottom: 5px solid white; border-radius: 30px; opacity: 0.5;" />
    </div>
    <div class="d-flex card shadow p-4 my-4 align-self-center rounded-start-0" style="background-color: #ffffff; border-radius: 15px; height: 540px;  width: 500px;">
        <div class="text-center mt-5">
            <div class="mb-0 text-start">
                <h1>Bem-Vindo!</h1>
                <span>Crie sua conta para continuar.</span>
            </div>
            <form class="mt-3 d-flex flex-column align-self-center">
                <div class="form-floating mb-2">
                    <input type="text" class="form-control" id="inputNome" placeholder="Digite o nome de usuário">
                    <label for="inputNome">Nome de usuário</label>
                </div>
                <div class="form-floating mb-2">
                    <input type="email" class="form-control" id="inputEmail" placeholder="nome@exemplo.com">
                    <label for="inputEmail">E-mail</label>
                </div>
                <div class="form-floating mb-2">
                    <input type="password" class="form-control" id="inputSenha" placeholder="Senha">
                    <label for="inputSenha">Senha</label>
                </div>
                <div class="form-floating mb-2">
                    <input type="password" class="form-control" id="inputConfirmSenha" placeholder="Confirme sua senha">
                    <label for="inputConfirmSenha">Confirmar Senha</label>
                </div>
                <button id="btnCadastro" type="button" class="btn btn-primary mt-3 w-100" asp-action="loginView" asp-controller="Login">Cadastrar</button>
            </form>
            <span>Já possui uma conta? <a asp-action="loginView" asp-controller="Login" asp-area="">Login</a></span>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/cadastro/cadastro.js" asp-append-version="true"></script>
</body>
