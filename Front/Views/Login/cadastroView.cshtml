@{
    ViewData["Title"] = "Cadastro";
    Layout = null;
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Front.styles.css" asp-append-version="true" />
</head>
<body class="d-flex justify-content-center" style="background-color: lightsteelblue">

    <div class="d-flex flex-column justify-content-center">
        <div class="text-center align-self-center rounded-top-3 align-content-center" style="background-color: #0F52BA; height: 110px; width: 700px;">
            <img src="/JPLM.png" style="height: 100px; object-fit: contain;" />
        </div>
        <div class="d-flex card shadow pt-2 p-4 align-self-center rounded-top-0" style="background-color: rgba(255, 255, 255); border-radius: 15px; height: 400px; width: 700px;">
            <div class="text-center" style="width: 100%;">
                <h1 class="mb-3 fs-2">Cadastro</h1>
                <form>
                    <div class="d-flex flex-column align-items-center gap-3 mb-3">
                        <input id="inputNome" type="text" class="form-control" placeholder="Digite o nome de usuário" />
                        <input id="inputEmail" type="email" class="form-control" placeholder="Digite o email a ser cadastrado" />
                        <input id="inputSenha" type="password" class="form-control" placeholder="Digite a sua senha" />
                        <input id="inputConfirmSenha" type="password" class="form-control" placeholder="Confirme sua senha" />
                    </div>
                    <button type="button" id="btnCadastro" class="btn btn-primary mt-4 w-100 mb-3">Cadastrar</button>
                    <span>Voltar para o <a asp-action="loginView" asp-controller="Login" asp-area="">Login</a></span>
                </form>
            </div>
        </div>

    </div>




    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/cadastro/cadastro.js" asp-append-version="true"></script>
</body>
