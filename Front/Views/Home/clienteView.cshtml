@{
    ViewData["Title"] = "Clientes";
}

<div class="card shadow p-4 my-4 col-10 offset-2">
    <div class="text-center">
        <div>
            <h1>@ViewData["Title"]</h1>
        </div>

        <div class="d-flex justify-content-between gap-5 mt-3">

            <div class="d-flex">

                <button id="buscar"class=" rounded-end-0 btn btn-primary align-items-center d-flex" onfocus="disabled">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                </button>

                <input class=" me-1 border w-100" type="search" id="pesquisarCliente" placeholder="Pesquisar" aria-label="Search" style="border-radius: 0px 15px 15px 0px;">

            </div>

            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalCadCliente">
                Cadastrar Cliente
            </button>
        </div>

        <table class="table table-striped my-3">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col" class="ms-">Nome</th>
                    <th scope="col">Alteraçõe   s</th>
                </tr>
            </thead>
            <tbody id="exibirClientes">
            </tbody>
        </table>

        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-between mt-5">
                <li class="page-item" id="btnVoltar"><a class="page-link" href="#">Voltar</a></li>
                <li class="page-item"><input placeholder="Digite uma Página" id="inputpage" type="number" class="form-control" /></li>
                <li class="page-item" id="paginaInfo"></li>
                <li class="page-item" id="btnAvancar"><a class="page-link" href="#">Avançar</a></li>
            </ul>
        </nav>

    </div>
</div>

@section Modals {
    <div class="modal fade" id="modalCadCliente" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Cadastro</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="form-group">
                            <label class="mt-2" for="nome">Nome</label>
                            <input placeholder="Nome" type="text" id="nome" class="form-control" />

                            <label class="mt-3" for="email">CPF</label>
                            <input placeholder="CPF" type="text" id="cpf" class="form-control" />

                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button id="enviar" type="button" class="btn btn-success">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEditarCliente" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Editar</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="form-group">
                            <label class="mt-2" for="nome">Nome</label>
                            <input placeholder="Nome" type="text" id="nomeEditar" class="form-control" />

                            <label class="mt-3" for="email">CPF</label>
                            <input placeholder="CPF" type="text" id="cpfEditar" class="form-control" />

                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button id="enviarAtualizacao" type="button" class="btn btn-success">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalExcluirCliente" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-content modal-dialog rounded-3 shadow">
            <div class="modal-body p-4 text-center">
                <h5 class="mb-0">Deseja realmente excluir este cliente?</h5> <p class="mb-0">Esta alteração não poderá ser desfeita.</p>
            </div>
            <div class="modal-footer flex-nowrap p-0">
                <button type="button" class="btn btn-lg  fs-6 text-decoration-none col-6 py-3 m-0 rounded-0 border-end">
                    <strong class="text-danger">Sim, <excluir></excluir>.</strong>
                </button>
                <button type="button" class="btn btn-lg btn-link fs-6 text-decoration-none col-6 py-3 m-0 rounded-0 fw-bold" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
    </div>
}

@section Scripts {
    <script src="~/js/cliente/clienteView.js" asp-append-version="true"></script>
}