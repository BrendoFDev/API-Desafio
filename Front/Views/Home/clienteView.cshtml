@{
    ViewData["Title"] = "Clientes";
}

<div class="text-center">
    <div>
        <div>
            <h1>@ViewData["Title"]</h1>
        </div>

        <div class="d-flex justify-content-between gap-5">

            <input class="form-control me-1 border rounded-3 w-25" type="search" placeholder="Pesquisar" aria-label="Search">

            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalCadCliente">
                Cadastrar Cliente
            </button>
        </div>

        <table class="table table-striped ">
            <thead >
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col" class="ms-">Nome</th>
                </tr>
            </thead>
            <tbody id="exibirClientes">
                <tr>
                    <th scope="row">1</th>
                    <td class="text-start">Mark Popó joe</td>
                </tr>
                <tr>
                    <th scope="row">2</th>
                    <td class="text-start">Jacob da Silva de Santana Pereira Nunes Monteiro Lobato Pikachu</td>
                </tr>
                <tr>
                    <th scope="row">3</th>
                    <td colspan="2" class="text-start">Virgulino Ferreira da Silva</td>
                </tr>
            </tbody>
        </table>

    </div>
</div>

@section Modals {
    <div class="modal fade" id="modalCadCliente" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Editar</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="form-group">
                            <label class="mt-2" for="nome">Nome</label>
                            <input placeholder="Nome" type="text" id="nome" class="form-control" />

                            <label class="mt-3" for="email">CPF</label>
                            <input placeholder="CPF" type="text" id="cpf" class="form-control" />

                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button id="enviar" type="button" class="btn btn-success">Confirmar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/cliente/clienteView.js" asp-append-version="true"></script>
}