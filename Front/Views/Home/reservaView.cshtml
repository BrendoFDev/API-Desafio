@{
    ViewData["Title"] = "Reservas";
}

<div class="card shadow p-4 my-4 col-10 offset-2">
    <div class="text-center">
        <div>
            <h1>Reservas</h1>
        </div>

        <div class="d-flex justify-content-between gap-5 mt-3">
        </div>

        <table class="table table-striped my-3">
            <thead>
                <tr>
                    <th scope="col">Id reserva</th>
                    <th scope="col">Modelo carro</th>
                    <th scope="col">Id cliente</th>
                    <th scope="col">Nome</th>
                    <th scope="col">Data da Reserva</th>
                    <th scope="col">Exluir</th>
                </tr>
            </thead>
            <tbody id="exibirReservas">
                                           
            </tbody>
        </table>

        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-between mt-5">
                <li class="page-item" id="btnVoltar"><a class="page-link" href="#">Voltar</a></li>
                <li class="page-item"><input placeholder="Digite uma Página" id="inputpage" type="number" class="form-control"></li>
                <li class="page-item" id="paginaInfo">
                    <span> Página Atual: 1 - Total de Páginas: 1 </span>
                </li>
                <li class="page-item" id="btnAvancar"><a class="page-link" href="#">Avançar</a></li>
            </ul>
        </nav>

    </div>
</div>

@section Scripts {
    <script src="~/js/reserva/reservaView.js" asp-append-version="true"></script>
}

@section Modals {
    <div id="modalExcluirReserva" class="modal fade" style="z-index: 1060;" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-content modal-dialog rounded-3 shadow">
                <div class="modal-body p-4 text-center">
                    <h5 class="mb-0">Deseja realmente excluir esta reserva?</h5> <p class="mb-0">Essa ação não poderá ser desfeita.</p>
                </div>
                <div class="modal-footer flex-nowrap p-0">
                    <button id="excluirReserva" type="button" class="btn btn-lg fs-6 text-decoration-none col-6 py-3 m-0 rounded-0 border-end">
                        <strong class="text-danger">Sim, excluir.</strong>
                    </button>
                    <button type="button" class="btn btn-lg btn-link fs-6 text-decoration-none col-6 py-3 m-0 rounded-0 fw-bold" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
}