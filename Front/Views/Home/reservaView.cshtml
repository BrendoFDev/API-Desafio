@{
    ViewData["Title"] = "Reservas";
}

<div class="card shadow p-4 my-4 col-10 offset-2">
    <div class="text-center">
        <div>
            <h1>Reservas</h1>
        </div>

        <div class="d-flex justify-content-between gap-5 mt-3">

        </div>

        <table class="table table-striped my-3">
            <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col">Modelos</th>
                </tr>
            </thead>
            <tbody id="exibirReservas">
                <tr>
                    <td scope="row">Nome do cliente 1</td>
                    <td class="text-center">Modelo do veículo 1</td>
                    
                </tr>

                <tr>
                    <td scope="row">Nome do cliente 2</td>
                    <td class="text-center">Modelo do veículo 2</td>
                   
                </tr>

                <tr>
                    <td scope="row">Nome do cliente 3</td>
                    <td class="text-center">Modelo do veículo 3</td>
                    
                </tr>
            </tbody>
        </table>

        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-between mt-5">
                <li class="page-item" id="btnVoltar"><a class="page-link" href="#">Voltar</a></li>
                <li class="page-item"><input placeholder="Digite uma Página" id="inputpage" type="number" class="form-control"></li>
                <li class="page-item" id="paginaInfo">
                    <span> Página Atual: 1 - Total de Páginas: 1 </span>
                </li>
                <li class="page-item" id="btnAvancar"><a class="page-link" href="#">Avançar</a></li>
            </ul>
        </nav>

    </div>
</div>