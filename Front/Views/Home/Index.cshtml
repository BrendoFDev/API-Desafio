@{
    ViewData["Title"] = "Home Page";
}

<div class="offset-2 d-flex justify-content-center">
    <div class="card shadow p-4 my-4" style="max-width: 1280px; background-color: rgba(255, 255, 255); border-radius: 15px;">
        <div class="text-center">

            <div class="text-end mb-4 justify-content-center d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalAdicionarMarca">
                    Adicionar Marca
                </button>
                <button id="btnModelo" type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalAdicionarModelo">
                    Adicionar Modelo
                </button>
                <button id="btnCarro" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
                    Adicionar Carro
                </button>
            </div>

            <div id="divRenderCars" class="row justify-content-start d-flex gap-0" style="width:900px">
                <span class="text-secondary fs-5 spanAlertCarros"></span>
            </div>

            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-between mt-5">
                    <li class="page-item" id="btnVoltar"><a class="page-link" href="#">Voltar</a></li>
                    <li class="page-item"><input placeholder="Digite uma Página" id="inputpage" type="number" class="form-control" /></li>
                    <li class="page-item" id="paginaInfo"></li>
                    <li class="page-item" id="btnAvancar"><a class="page-link" href="#">Avançar</a></li>
                </ul>
            </nav>

        </div>
    </div>
</div>

@section Modals {

                    @* CADASTRAR CARRO *@
    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Adicionar Carro</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <div class="row justify-content-center d-flex flex-column gap-3">
                            <div class="d-flex flex-column gap-3">
                                <div class="col-auto">
                                    <div>
                                        <label for="modelosCarro" class="fw-medium col-auto fs-5 form-label">Escolha uma opção:</label>
                                        <select id="modelosCarro" class="form-select rounded-2 col-auto fs-5 ">
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputAF" class="fw-medium col-auto fs-5 form-label">Ano do Veículo:</label>
                                <input id="inputAF" type="number" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe o ano do veículo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputC" class="fw-medium col-auto fs-5 form-label">Cor:</label>
                                <input id="inputC" type="text" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe a cor do veículo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputP" class="fw-medium col-auto fs-5 form-label">Preço:</label>
                                <input id="inputP" type="number" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe o valor do veículo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                        </div>
                    </form>

                </div>
                <div class="modal-footer">
                    <span class="text-secondary fs-5 spanAlertCad"></span>
                    <button id="adcarro" type="button" class="btn btn-primary">ADICIONAR</button>
                </div>
            </div>
        </div>
    </div>


                    @* EDITAR CARRO *@
    <div class="modal fade" id="modalEditar" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Editar</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <label for="inputEditAF" class="fw-medium col-auto fs-5 form-label">Ano do veículo:</label>
                                <input id="inputEditAF" type="number" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe o ano do veículo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputEditC" class="fw-medium col-auto fs-5 form-label">Cor:</label>
                                <input id="inputEditC" type="text" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe a cor do veículo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputEditP" class="fw-medium col-auto fs-5 form-label">Preço:</label>
                                <input id="inputEditP" type="number" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe o valor do veículo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                        </div>
                    </form>

                </div>
                <div class="modal-footer">
                    <span class="text-secondary fs-5 spanAlertEdit"></span>
                    <button id="modalAddImg" class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#modalAddImagem">
                        Adicionar Imagem
                    </button>
                    <button id="editCarro" type="button" class="btn btn-primary">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

                    @* RESERVAR CARRO *@
    <div class="modal fade" id="modalReserva" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Reservar</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <label for="inputReserva" class="fw-medium col-auto fs-5 form-label">CPF:</label>
                                <input id="inputReserva" type="text" class="rounded-2 col-auto fs-5 form-control" placeholder="000.000.000-00" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                        </div>
                    </form>

                </div>
                <div class="modal-footer d-flex justify-content-end mt-4">
                    <span class="spanAlertReserva text-danger fs-5"></span>
                    <button id="btnReserva" type="button" class="btn btn-success">RESERVAR</button>
                </div>
            </div>
        </div>
    </div>

                    @* ADCIONAR MARCA *@
    <div class="modal fade" id="modalAdicionarMarca" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Adicionar Marca</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <label for="inputAddMod" class="fw-medium col-auto fs-5 form-label">Marca:</label>
                                <input id="inputAddMod" type="text" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe a marca" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>

                        </div>
                    </form>

                </div>
                <div class="modal-footer d-flex justify-content-end mt-4">
                    <span class="spanAlertAddMarca text-danger fs-5"></span>
                    <button id="btnAddMarca" type="button" class="btn btn-success">ADICIONAR</button>
                </div>
            </div>
        </div>
    </div>

                    @* ADICIONAR MODELO *@
    <div class="modal fade" id="modalAdicionarModelo" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Adicionar Modelo</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <div class="row justify-content-center">
                            <div class="col-auto d-flex flex-column gap-3">
                                <div>
                                    <label for="marcas" class="fw-medium col-auto fs-5 form-label">Escolha uma opção:</label>
                                    <select id="marcas" class="form-select rounded-2 col-auto fs-5 ">
                                    </select>
                                </div>
                                <div>
                                    <label for="inputAddModelo" class="fw-medium col-auto fs-5 form-label">Modelo:</label>
                                    <input id="inputAddModelo" type="text" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe o modelo" required />
                                    <div class="invalid-feedback">
                                        <span>Preencha o campo!</span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </form>

                </div>
                <div class="modal-footer d-flex justify-content-end mt-4">
                    <span class="spanAlertEnviarModelo text-danger fs-5"></span>
                    <button id="btnAddModelo" type="button" class="btn btn-success">ADICIONAR</button>
                </div>
            </div>
        </div>
    </div>
    @* EXCLUIR CARROS *@
    <div id="modalExcluirCarro" class="modal fade" style="z-index: 1060;" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-content modal-dialog rounded-3 shadow">
            <div class="modal-body p-4 text-center">
                <h5 class="mb-0">Deseja realmente excluir este carro?</h5> <p class="mb-0">Essa ação não poderá ser desfeita.</p>
                <span class="spanAlertExcluirCarro text-danger fs-5"></span>
            </div>
            <div class="modal-footer flex-nowrap p-0">
                <button id="excluir" type="button" class="btn btn-lg  fs-6 text-decoration-none col-6 py-3 m-0 rounded-0 border-end">
                    <strong class="text-danger">Sim, excluir.</strong>
                </button>
                <button type="button" class="btn btn-lg btn-link fs-6 text-decoration-none col-6 py-3 m-0 rounded-0 fw-bold" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>

    @* ADICIONAR IMAGENS *@
    <div id="modalAddImagem" class="modal fade" style="z-index: 1060;" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Adicionar/Editar Imagem</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-auto">

                        <p class="fs-5">Área de renderização de imagens:</p>

                        <div class="divImagensCarro d-flex justify-content-center cols-12 gap-1">

                            <div class="col-4 text-center justify-content-between bg-secondary bg-opacity-50 p-1 rounded-2" style="background-image: url('data:image/jpeg;base64,'); background-size: cover; background-position: center; background-repeat: no-repeat;">
                                <div class="d-flex justify-content-between align-self-center">
                                    <p class="text-light bg-secondary bg-opacity-50 rounded-1 p-1 pt-0 pb-0">1</p>
                                    <div class="fs-6">
                                        <button id="btnTrocarImagem" type="button" class="btn bg-secondary bg-opacity-50 p-1 pt-0 pb-0 m-0 shadow-none" onclick="this.blur();">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="yellow" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                              <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
