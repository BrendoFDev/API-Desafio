@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">

    <div class="text-end">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
            Adicionar Carro
        </button>
    </div>

    <div id="divRenderCars" class="row justify-content-start d-flex gap-sm-5">
    </div>

    <nav aria-label="Page navigation example">
        <ul class="pagination">
            <li class="page-item"><a class="page-link" href="#">Previous</a></li>
            <li class="page-item"><<input id="inputpage" type="number" /></li>
            <li class="page-item"><a class="page-link" href="#">Next</a></li>
        </ul>
    </nav>

</div>

@section Modals {

    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Adicionar Carro</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                        @* CADASTRAR CARRO *@
                    <form class="needs-validation" novalidate>
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <label for="inputMa" class="fw-medium col-auto fs-5 form-label">Marca:</label>
                                <input id="inputMa" type="text" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe a marca do veículo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputMo" class="fw-medium col-auto fs-5 form-label">Modelo:</label>
                                <input id="inputMo" type="text" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe o modelo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputAF" class="fw-medium col-auto fs-5 form-label">Ano de Fabricação:</label>
                                <input id="inputAF" type="number" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe o ano de fabricação" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputC" class="fw-medium col-auto fs-5 form-label">Cor:</label>
                                <input id="inputC" type="text" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe a cor do veículo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputP" class="fw-medium col-auto fs-5 form-label">Preço:</label>
                                <input id="inputP" type="number" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe o valor do veículo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                        </div>
                    </form>

                </div>
                <div class="modal-footer">
                    <button id="adcarro" type="button" class="btn btn-primary">Adicionar</button>
                </div>
            </div>
        </div>
    </div>


    <div class="modal fade" id="modalEditar" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Editar</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                        @* EDITAR CARRO *@
                    <form class="needs-validation" novalidate>
                        <div class="row justify-content-center">
                            <div class="col-auto">
                                <label for="inputEditMa" class="fw-medium col-auto fs-5 form-label">Marca:</label>
                                <input id="inputEditMa" type="text" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe a marca do veículo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputEditMo" class="fw-medium col-auto fs-5 form-label">Modelo:</label>
                                <input id="inputEditMo" type="text" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe o modelo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputEditAF" class="fw-medium col-auto fs-5 form-label">Ano de Fabricação:</label>
                                <input id="inputEditAF" type="number" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe o ano de fabricação" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputEditC" class="fw-medium col-auto fs-5 form-label">Cor:</label>
                                <input id="inputEditC" type="text" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe a cor do veículo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label for="inputEditP" class="fw-medium col-auto fs-5 form-label">Preço:</label>
                                <input id="inputEditP" type="number" class="rounded-2 col-auto fs-5 form-control" placeholder="Informe o valor do veículo" required />
                                <div class="invalid-feedback">
                                    <span>Preencha o campo!</span>
                                </div>
                            </div>
                        </div>
                    </form>

                </div>
                <div class="modal-footer">
                    <button id="editCarro" type="button" class="btn btn-primary">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

}

@section Scripts {
    <script src="~/js/carro/carroView.js" asp-append-version="true"></script>
}
