@{
    ViewData["Title"] = "Cadastro Cliente";
}

<div class="text-center">
    <div class="justify-content-center ">
        <h1>@ViewData["Title"]</h1>
    </div>

    <div class="d-flex justify-content-center">
        <div class="form-card rounded-2 w-25  box-shadow border border-dark p-3 mt-5 justify-content-center">
            <form action="/Usuario/Cadastrar" method="post">
                <div class="form-group">
                    <label class ="mt-2" for="email">Nome</label>
                    <input placeholder="Nome" type="email" id="email" name="Email" class="form-control" />

                    <label class="mt-3" for="email">CPF</label>
                    <input placeholder="CPF" type="email" id="email" name="Email" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary mt-3">Enviar</button>
            </form>

        </div>
    </div>
</div>
