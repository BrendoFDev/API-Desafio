<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Front</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Front.styles.css" asp-append-version="true" />
</head>
<body class="d-flex">
    <header class="col-2 fs-5 shadow-lg position-fixed top-0 start-0 vh-100" style="background-color:lightsteelblue">

        <div class="sidebar-sticky">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link  text-dark" asp-area="" asp-controller="Home" asp-action="Index">Carros</a>
                </li>
            </ul>

                
            <ul class="nav flex-column mb-2">
                <li class="nav-item">
                    <a class="nav-link  text-dark" asp-area="" asp-controller="Home" asp-action="clienteView">Clientes</a>
                </li>
            </ul>
        </div>
    </header>
    <div class="container col-9 mt-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* <footer class="border-top footer text-muted" style="background-color: #B0E0E6">
        <div class="container">
            &copy; 2026 - Front - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Modals", required: false);
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>